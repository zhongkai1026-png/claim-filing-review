# ============================================================
# 备案通过、绑定域名后的 HTTPS 配置参考（第二阶段使用）
# 放置到 /etc/nginx/conf.d/claim.conf，替换域名与证书路径后:
#   nginx -t && systemctl reload nginx
# 同时把接收服务改到内网端口（编辑 /opt/claim-receiver/.env 设 CLOUD_PORT=8001
# 并 systemctl restart claim-receiver），公网只暴露 Nginx 的 80/443。
# ============================================================

server {
    listen 80;
    server_name claim.example.com;          # ← 改为你的域名
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name claim.example.com;          # ← 改为你的域名

    # 阿里云免费证书（数字证书管理服务下载 Nginx 版后上传到服务器）
    ssl_certificate     /etc/ssl/claim/claim.example.com.pem;
    ssl_certificate_key /etc/ssl/claim/claim.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 上传材料最大 50MB（Nginx 默认只有 1MB，必须设置）
    client_max_body_size 50m;

    # 静态申报页（债权申报.html）
    root /opt/claim-receiver/static;
    index index.html;

    # 接收服务反代（接收服务监听 127.0.0.1:8001）
    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
